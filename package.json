{
  "name": "vidhan-bot",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "vidhan-bot": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --packages=external --outdir=dist",
    "check": "tsc --noEmit",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "async-mutex": "^0.5.0",
    "discord.js": "^14.22.1",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.4.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "oxfmt": "0.68.0",
    "oxlint": "1.86.0",
    "typescript": "^5.9.3"
  }
}
