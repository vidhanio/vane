{
  "name": "vane",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "vane": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --packages=external --outdir=dist",
    "check": "bun check",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check .",
    "lint": "bun lint --max-warnings 0 src",
    "lint:fix": "bun lint --fix src"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "async-mutex": "^0.5.0",
    "discord.js": "^14.27.0",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/proper-lockfile": "^4.1.4"
  }
}
